---
import { getCacheControlHeader, getSiteData } from '../lib/api';
import { euros, formatDateRangeFr, formatPriceRange, formatShortDateFr, photoAttrs } from '../lib/format';
import { buildJsonLd, isIndexable, SITE_URL } from '../lib/seo';

const data = await getSiteData();
const { adhesion, centresAeres: d, summary } = data;
const indexable = isIndexable();

Astro.response.headers.set('Cache-Control', getCacheControlHeader());

const jsonLdString = JSON.stringify(buildJsonLd(data)).replace(/</g, '\\u003c');

// Précalcul des attributs WebP responsive pour chaque photo
const pHero = photoAttrs('club-voile-bassin-rond-bouchain', '100vw');
const pPorteStages = photoAttrs('stage-voile-enfants-ponton', '(max-width: 760px) 80vw, (max-width: 1100px) 50vw, 25vw');
const pPorteGroupes = photoAttrs('groupe-kayaks-paddles-bassin-rond', '(max-width: 760px) 80vw, (max-width: 1100px) 50vw, 25vw');
const pPorteLocation = photoAttrs('location-canoe-kayak-paddle-bassin-rond', '(max-width: 760px) 80vw, (max-width: 1100px) 50vw, 25vw');
const pPorteAdhesion = photoAttrs('adhesion-jeunes-paddle-geant-bassin-rond', '(max-width: 760px) 80vw, (max-width: 1100px) 50vw, 25vw');
const pLieu = photoAttrs('bassin-rond-voiliers-foret', '(max-width: 760px) 100vw, 50vw');
const pStagesA = photoAttrs('stage-voile-enfants-ponton', '(max-width: 760px) 100vw, 50vw');
const pStagesB = photoAttrs('stage-voile-ilca-optimist', '(max-width: 760px) 100vw, 50vw');
const pFlotte = photoAttrs('flotte-deriveurs-bassin-rond', '(max-width: 760px) 100vw, 50vw');
const pGroupes = photoAttrs('groupe-kayaks-paddles-bassin-rond', '(max-width: 760px) 100vw, 50vw');
const pLocation = photoAttrs('location-canoe-kayak-paddle-bassin-rond', '100vw');
const pAdhesion = photoAttrs('adhesion-jeunes-paddle-geant-bassin-rond', '100vw');
const pVqA = photoAttrs('24-heures-bassin-rond-baptemes-nautiques', '(max-width: 760px) 100vw, 50vw');
const pVqB = photoAttrs('24-heures-bassin-rond-concert', '(max-width: 760px) 100vw, 50vw');
const pVqC = photoAttrs('24-heures-bassin-rond-ateliers-creatifs', '(max-width: 760px) 50vw, 25vw');
const pVqD = photoAttrs('24-heures-bassin-rond-jeux-animations', '(max-width: 760px) 50vw, 25vw');
const pVie = photoAttrs('vie-du-club-deriveurs-bassin-rond', '(max-width: 760px) 100vw, 50vw');

// Formatage intro adhésion
const introBase = adhesion.intro.replace(/[\s.:]+$/, '');
const livretContenu = d.livret.contenu;
const livretListeTexte =
  livretContenu.length >= 2
    ? `${livretContenu.slice(0, -1).join(', ')} et ${livretContenu[livretContenu.length - 1]}`
    : livretContenu.join('');
const livretPartPct = d.livret.prix > 0 ? Math.round((d.livret.prise_en_charge_club / d.livret.prix) * 100) : 0;
const annexes = [d.cotisation_groupe, ...d.camping, d.forfait_energie];

// Sous-titres éditoriaux des embarcations de location (enrichis par les tarifs & dispo live)
const SUPPORT_DESCRIPTIONS: Record<string, string> = {
  'canoe-bi': 'en duo sur le plan d’eau',
  'canoe-mono': 'en solo sur le plan d’eau',
  kayak: 'en solo ou en duo sur le plan d’eau',
  canoe: 'idéal en famille ou entre amis',
  paddle: "parfait pour une première fois sur l'eau",
  'paddle-geant': "jusqu'à 8 personnes à bord",
  hansa: 'bateau double, adapté au handicap et facile à prendre en main',
};

const upcomingSessions = (summary?.prochaines_sessions_stage ?? []).slice(0, 4);
const liveSupports = summary?.supports_location ?? [];
const nextLocationDate = liveSupports
  .flatMap((s) => s.prochaines_dates_ouvertes)
  .sort()[0] ?? null;

const currentYear = new Date().getFullYear();
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
{!indexable && (
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai">
)}
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CDPA Bassin-Rond — Club de voile, stages &amp; location à Bouchain</title>
<meta name="description" content="Club et école de voile à Bouchain (Nord) : stages jeunes et adultes, location canoë et paddle, tarifs adhésion, groupes et centres aérés, et les 24 heures du Bassin-Rond.">
<link rel="canonical" href={`${SITE_URL}/`}>
<meta property="og:type" content="website">
<meta property="og:locale" content="fr_FR">
<meta property="og:site_name" content="CDPA Bassin-Rond">
<meta property="og:title" content="CDPA Bassin-Rond — Club de voile, stages &amp; location à Bouchain">
<meta property="og:description" content="Club et école de voile à Bouchain (Nord) : stages jeunes et adultes, location canoë et paddle, tarifs adhésion, groupes et centres aérés, et les 24 heures du Bassin-Rond.">
<meta property="og:url" content={`${SITE_URL}/`}>
<meta property="og:image" content={`${SITE_URL}/images/photos/club-voile-bassin-rond-bouchain-1200.webp`}>
<meta property="og:image:alt" content="Trois voiliers à voiles blanches et bleues sur le Bassin-Rond, à Bouchain.">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href={`/css/style.css?v=${import.meta.env.PUBLIC_ASSET_VERSION || process.env.PUBLIC_ASSET_VERSION || '1'}`}>
<script src={`/js/main.js?v=${import.meta.env.PUBLIC_ASSET_VERSION || process.env.PUBLIC_ASSET_VERSION || '1'}`} defer></script>
<link rel="preload" as="image" href={pHero.src} imagesrcset={pHero.srcset} imagesizes="100vw" fetchpriority="high">
<script type="application/ld+json" data-seo-jsonld set:html={jsonLdString} />
</head>
<body id="top">
<a class="skip" href="#contenu">Aller au contenu</a>

<header class="top">
  <a class="brand" href="#top" aria-label="CDPA Bassin-Rond, retour en haut">
    <img src="/images/logo/BR-logo.png" width="347" height="239" alt="">
    <span>CDPA Bassin-Rond</span>
  </a>
  <button class="menu" type="button" aria-expanded="false" aria-controls="nav-liste">
    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span>Menu</span>
  </button>
  <nav class="nav" aria-label="Navigation principale">
    <ul id="nav-liste">
      <li><a href="#stages">Stages</a></li>
      <li><a href="#groupes">Groupes</a></li>
      <li><a href="#location">Location</a></li>
      <li><a href="#adhesion">Adhésion</a></li>
      <li><a href="#les-24-heures-du-bassin-rond">Les 24 h</a></li>
      <li><a href="#videos">Vidéos</a></li>
      <li><a href="#infos">Contact</a></li>
    </ul>
  </nav>
  <a class="tel" href="tel:+33327357228">
    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6.6 3.5h3l1.5 4-2 1.3a11 11 0 0 0 6.1 6.1l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z"/></svg>
    <span>03 27 35 72 28</span>
  </a>
</header>

<nav class="rail" aria-label="Sections de la page">
  <ol>
    <li><a href="#lieu" data-rail><span>Le lieu</span></a></li>
    <li><a href="#stages" data-rail><span>Stages</span></a></li>
    <li><a href="#groupes" data-rail><span>Groupes</span></a></li>
    <li><a href="#location" data-rail><span>Location</span></a></li>
    <li><a href="#adhesion" data-rail><span>Adhésion</span></a></li>
    <li><a href="#les-24-heures-du-bassin-rond" data-rail><span>Les 24 h</span></a></li>
    <li><a href="#videos" data-rail><span>Vidéos</span></a></li>
    <li><a href="#infos" data-rail><span>Infos</span></a></li>
  </ol>
  <span class="rail__sun" aria-hidden="true">
    <svg viewBox="0 0 40 40" class="soleil"><g class="soleil__rayons"><path class="soleil__halo" d="M20.00 8.50L20.00 3.00M26.76 10.70L29.99 6.25M30.94 16.45L36.17 14.75M30.94 23.55L36.17 25.25M26.76 29.30L29.99 33.75M20.00 31.50L20.00 37.00M13.24 29.30L10.01 33.75M9.06 23.55L3.83 25.25M9.06 16.45L3.83 14.75M13.24 10.70L10.01 6.25"/><path d="M20.00 8.50L20.00 3.00M26.76 10.70L29.99 6.25M30.94 16.45L36.17 14.75M30.94 23.55L36.17 25.25M26.76 29.30L29.99 33.75M20.00 31.50L20.00 37.00M13.24 29.30L10.01 33.75M9.06 23.55L3.83 25.25M9.06 16.45L3.83 14.75M13.24 10.70L10.01 6.25"/></g><circle class="soleil__ombre" cx="20" cy="20" r="8.6"/><circle class="soleil__disque" cx="20" cy="20" r="8"/><circle class="soleil__reflet" cx="17.4" cy="17.4" r="2.6"/></svg>
  </span>
</nav>

<main id="contenu">

  <section class="hero" aria-labelledby="frise-titre">
    <figure class="hero__photo">
      <img src={pHero.src} srcset={pHero.srcset} sizes={pHero.sizes} width="1800" height="1350" alt="Trois voiliers à voiles blanches et bleues sur le Bassin-Rond, sous un grand ciel de cumulus." fetchpriority="high">
    </figure>

    <div class="portes" role="group" aria-labelledby="frise-titre">
      <h1 class="portes__titre" id="frise-titre">Votre <em>moment</em> au CDPA Bassin-Rond</h1>
      <ol class="portes__liste">
        <li class="porte">
          <img src={pPorteStages.src} srcset={pPorteStages.srcset} sizes={pPorteStages.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="">
          <a class="porte__lien" href="#stages">
            <span class="porte__quoi">Un stage pour mon enfant… ou pour moi</span>
            <span class="porte__qui">Stages jeunes de 7 à 17 ans, et stages adultes</span>
          </a>
          <a class="porte__direct" href="https://stages.bassin-rond.net/">Voir les dates<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
        </li>
        <li class="porte">
          <img src={pPorteGroupes.src} srcset={pPorteGroupes.srcset} sizes={pPorteGroupes.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="">
          <a class="porte__lien" href="#groupes">
            <span class="porte__quoi">Venir en groupe</span>
            <span class="porte__qui">Les formules centres aérés</span>
          </a>
        </li>
        <li class="porte">
          <img src={pPorteLocation.src} srcset={pPorteLocation.srcset} sizes={pPorteLocation.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="">
          <a class="porte__lien" href="#location">
            <span class="porte__quoi">Louer un bateau</span>
            <span class="porte__qui">Canoë, kayak, paddle, Hansa</span>
          </a>
          <a class="porte__direct" href="https://location.bassin-rond.net/">Réserver un créneau<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
        </li>
        <li class="porte">
          <img src={pPorteAdhesion.src} srcset={pPorteAdhesion.srcset} sizes={pPorteAdhesion.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="">
          <a class="porte__lien" href="#adhesion">
            <span class="porte__quoi">Naviguer toute l'année</span>
            <span class="porte__qui">L'adhésion au club</span>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <section class="chapitre chapitre--lieu" id="lieu" data-section aria-labelledby="lieu-titre">
    <div class="ouverture">
      <figure class="ouverture__photo grade-frais">
        <img src={pLieu.src} srcset={pLieu.srcset} sizes={pLieu.sizes} width="2390" height="1792" loading="lazy" decoding="async" alt="Un Ilca et des Optimist naviguent sur le Bassin-Rond, devant une péniche et la berge boisée sous un ciel bleu.">
      </figure>
      <div class="ouverture__texte">
        <h2 id="lieu-titre">L'eau d'abord, la forêt tout autour</h2>
        <p>Le Bassin-Rond est un plan d'eau intérieur, calme et protégé. Les péniches rappellent le passé batelier du site, la forêt borde les rives, et l'on y glisse sur un moyen de locomotion écologique, non bruyant et non polluant.</p>
        <p>C'est un terrain idéal pour apprendre : on navigue dans un contexte sécurisé, quel que soit son âge et son profil.</p>
      </div>
    </div>
  </section>

  <section class="chapitre chapitre--stages" id="stages" data-section aria-labelledby="stages-titre">
    <div class="stages">
      <div class="stages__texte">
        <h2 id="stages-titre">Un stage pour mon enfant… ou pour moi</h2>
        <p class="fait">Stages jeunes : <span class="num">14 h – 17 h</span>, pendant les vacances</p>
        <p>Pendant les vacances scolaires, les jeunes de 7 à 17 ans passent leurs après-midi sur l'eau, à la semaine. Ils sont encadrés par des moniteurs diplômés d'État, sur un plan d'eau calme où l'on progresse vite, du premier bord aux manœuvres avancées. Beaucoup reviennent d'une année sur l'autre.</p>
        <p>Le club propose aussi des stages pour les adultes : les sessions ouvertes sont annoncées sur le site des stages.</p>
        {upcomingSessions.length > 0 && (
          <div class="live-sessions" data-live-stages>
            <p class="live-sessions__titre">Prochaines sessions ouvertes ({summary?.annee_saison})</p>
            <ul class="live-sessions__liste">
              {upcomingSessions.map((session) => (
                <li>
                  <span class="live-sessions__dates">
                    {formatDateRangeFr(session.debut, session.fin)}
                  </span>
                  <span class="live-sessions__meta">
                    {session.nom} · <span class="num">{euros(session.price)}</span> ·{' '}
                    <span class="live-sessions__places num">
                      {session.disponible} place{session.disponible > 1 ? 's' : ''}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
        <a class="bouton bouton--plein" href="https://stages.bassin-rond.net/">Voir les dates et s'inscrire<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
      </div>
      <figure class="stages__photo stages__photo--a grade-net">
        <img src={pStagesA.src} srcset={pStagesA.srcset} sizes={pStagesA.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="Des enfants en gilet de sauvetage s'installent sur leurs bateaux au départ du ponton.">
      </figure>
      <figure class="stages__photo stages__photo--b grade-net">
        <img src={pStagesB.src} srcset={pStagesB.srcset} sizes={pStagesB.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="Un Ilca et un Optimist passent une bouée, l'eau scintille au soleil.">
      </figure>
    </div>

    <div class="flotte" aria-labelledby="flotte-titre">
      <figure class="flotte__photo grade-net">
        <img src={pFlotte.src} srcset={pFlotte.srcset} sizes={pFlotte.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="Une flotte serrée de dériveurs aux voiles blanches, rouges et turquoise.">
      </figure>
      <div class="flotte__liste">
        <h3 id="flotte-titre">Un bateau pour chaque âge</h3>
        <ul>
          <li><span class="age">dès <span class="num">7</span> ans</span><strong>Optimist</strong><span>LE bateau pour découvrir la voile en toute sécurité.</span></li>
          <li><span class="age">à deux</span><strong>Catamaran Newcat 12</strong><span>Pour les plus jeunes : à deux, plein de place, plus rigolo.</span></li>
          <li><span class="age">solo ou double</span><strong>RS Quba</strong><span>Ultra polyvalent, parfait pour débuter en solo ou en double.</span></li>
          <li><span class="age">dès <span class="num">11</span> ans</span><strong>Open Bic</strong><span>Il faut déjà avoir du niveau pour grimper cette monture.</span></li>
          <li><span class="age">dès <span class="num">14</span> ans</span><strong>Ilca</strong><span>Vif, rapide et adaptable : des sensations assurées.</span></li>
          <li><span class="age">à deux</span><strong>420</strong><span>À deux équipiers, pour débuter et aller jusqu'à la compétition.</span></li>
          <li><span class="age">à plusieurs</span><strong>Ludic</strong><span>Bateau collectif, pour découvrir la voile tout en douceur.</span></li>
          <li><span class="age">à deux</span><strong>Hansa</strong><span>Bateau double, adapté au handicap et facile à prendre en main.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="chapitre chapitre--groupes" id="groupes" data-section aria-labelledby="groupes-titre">
    <div class="groupes">
      <div class="groupes__tete">
        <h2 id="groupes-titre">Venir en groupe et centres aérés</h2>
        <p>Les formules et tarifs ci-dessous sont réservés aux centres aérés : séjours de 4 ou 5 jours, à la journée ou à la demi-journée. Groupes de {d.groupe_minimum} personnes minimum ; {d.inclus.charAt(0).toLowerCase() + d.inclus.slice(1)}</p>
        <p class="groupes__autres">Comité d'entreprise, journée d'intégration ou autre groupe ? Le club vous accueille aussi : <a href="#infos">contactez-nous</a> pour organiser votre venue.</p>
      </div>
      <figure class="groupes__photo grade-net">
        <img src={pGroupes.src} srcset={pGroupes.srcset} sizes={pGroupes.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="Des jeunes en kayaks et paddles devant le hangar du club, les Optimist alignés au ponton.">
      </figure>

      <div class="tarif-groupes">
        <fieldset class="bascule">
          <legend>Durée du séjour</legend>
          <input type="radio" name="duree" id="r-4-jours" value="4-jours" checked>
          <label for="r-4-jours">4 jours</label>
          <input type="radio" name="duree" id="r-5-jours" value="5-jours">
          <label for="r-5-jours">5 jours</label>
        </fieldset>
        {d.durees.map((duree) => (
          <div class="duree" id={`duree-${duree.id}`}>
            <h3 class="duree__titre" data-duree-titre={duree.id}>{duree.libelle}</h3>
            <ul class="formules-g" data-formules={duree.id}>
              {duree.formules.map((f) => (
                <li class:list={['formule-g', { 'formule-g--phare': f.plus_demande }]}>
                  <h4>
                    {f.nom}
                    {f.plus_demande && <span class="formule-g__badge">Le plus demandé</span>}
                  </h4>
                  <p class="formule-g__prix">
                    <span class="num">{euros(f.prix)}</span> {d.unite}
                  </p>
                  <p>{f.description}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="annexes">
          <div class="annexe">
            <h3>Camping et cotisation groupe</h3>
            <table class="grille">
              <tbody data-annexes>
                {annexes.map((item) => (
                  <tr>
                    <th scope="row">
                      {item.libelle}
                      {item.precision && (
                        <>
                          <br />
                          <small>{item.precision}</small>
                        </>
                      )}
                    </th>
                    <td>
                      <span class="num">{euros(item.prix)}</span> {item.unite}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="annexe">
            <h3>Le livret de certification</h3>
            <p data-livret-texte>
              {d.livret.description.replace(/\.$/, '')} : {livretListeTexte}.
            </p>
            <p class="livret" data-livret>
              <span class="num">{euros(d.livret.prix)}</span> le livret, dont{' '}
              <strong>
                <span class="num">{euros(d.livret.prise_en_charge_club)}</span> pris en charge par le club
              </strong>{' '}
              ({livretPartPct}&nbsp;%). Il reste <span class="num">{euros(d.livret.reste_a_charge)}</span> par livret à votre charge, si vous choisissez ce mode de validation.
            </p>
          </div>
        </div>

        <div class="groupes__action">
          <a class="bouton bouton--plein" href="#infos">Demander des renseignements</a>
          <a class="lien" href="tel:+33327357228">ou appelez le <span class="num">03 27 35 72 28</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="chapitre chapitre--location" id="location" data-section aria-labelledby="location-titre">
    <figure class="plein grade-net">
      <img src={pLocation.src} srcset={pLocation.srcset} sizes={pLocation.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="Canoës, kayaks et paddles colorés sur le bassin, devant les péniches et les grands arbres.">
    </figure>
    <div class="location">
      <h2 id="location-titre">Louer un bateau, en famille ou entre amis</h2>
      <p class="location__intro">Pas besoin d'être licencié : on choisit son embarcation et son créneau en ligne, on règle, et la confirmation arrive par e-mail avec un QR code d'accès. Débutants bienvenus.</p>
      {summary && (
        <p class="location__statut" data-live-location-status>
          {summary.location_ouverte && nextLocationDate
            ? `Créneaux ouverts en ligne — prochaines disponibilités dès le ${formatShortDateFr(nextLocationDate)}.`
            : 'Consultez le calendrier en ligne pour voir les prochains créneaux ouverts.'}
        </p>
      )}
      {liveSupports.length > 0 ? (
        <ul class="embarcations" data-live-location>
          {liveSupports.map((sup) => {
            const range = formatPriceRange(sup.prix_min, sup.prix_max);
            const desc = SUPPORT_DESCRIPTIONS[sup.id] ?? 'réservation en ligne à la séance';
            return (
              <li>
                <a href={`https://location.bassin-rond.net/reservation/${sup.id}`}>
                  <span class="embarcations__tete">
                    <strong>{sup.nom}</strong>
                    {range && <span class="embarcations__prix num">{range}</span>}
                  </span>
                  <span>{desc}</span>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <ul class="embarcations">
          <li><strong>Canoë et kayak</strong><span>en solo ou en duo</span></li>
          <li><strong>Paddle</strong><span>parfait pour une première fois sur l'eau</span></li>
          <li><strong>Paddle géant</strong><span>jusqu'à 8 personnes à bord</span></li>
          <li><strong>Hansa</strong><span>bateau double, adapté au handicap et facile à prendre en main</span></li>
        </ul>
      )}
      <a class="bouton bouton--plein" href="https://location.bassin-rond.net/">Réserver une embarcation<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
    </div>
  </section>

  <section class="chapitre chapitre--adhesion" id="adhesion" data-section aria-labelledby="adhesion-titre">
    <figure class="plein plein--dore grade-dore">
      <img src={pAdhesion.src} srcset={pAdhesion.srcset} sizes={pAdhesion.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="Des jeunes du club font une pyramide en riant sur un paddle géant, sur le Bassin-Rond.">
    </figure>
    <div class="adhesion">
      <h2 id="adhesion-titre">Adhésion et tarifs à l'année</h2>
      <p class="adhesion__intro" data-adhesion-intro>
        {introBase}
        {(adhesion.licencies > 0 || adhesion.labels_federaux > 0) && (
          <>
            {' : '}
            {adhesion.licencies > 0 && (
              <>
                <strong class="num">{adhesion.licencies}</strong>{' '}
                {adhesion.licencies > 1 ? 'licenciés' : 'licencié'}
              </>
            )}
            {adhesion.licencies > 0 && adhesion.labels_federaux > 0 && ' et '}
            {adhesion.labels_federaux > 0 && (
              <>
                <strong class="num">{adhesion.labels_federaux}</strong>{' '}
                {adhesion.labels_federaux > 1 ? 'labels fédéraux' : 'label fédéral'}
              </>
            )}
          </>
        )}
        .
      </p>
      <div class="formules" data-tarifs="adhesion">
        {adhesion.formules.map((f) => (
          <div class="formule">
            <h3>{f.nom}</h3>
            <p class="formule__prix">
              <span class="num">{euros(f.total)}</span> <span>l'année</span>
            </p>
            {f.prix_seance ? (
              <p class="formule__seance">
                soit <span class="num">{euros(f.prix_seance)}</span> la séance
              </p>
            ) : null}
            <dl>
              <div><dt>Cotisation</dt><dd class="num">{euros(f.cotisation)}</dd></div>
              <div><dt>Licence</dt><dd class="num">{euros(f.licence)}</dd></div>
              <div><dt>Forfait séances</dt><dd class="num">{euros(f.forfait_seances)}</dd></div>
            </dl>
            <p class="formule__supports">{f.supports.join(', ')}</p>
          </div>
        ))}
        {adhesion.famille && (
          <div class="formule formule--famille">
            <div class="formule__tete">
              <h3>{adhesion.famille.nom}</h3>
              {adhesion.famille.total_precision && (
                <p class="formule__total-variable">{adhesion.famille.total_precision}</p>
              )}
              {adhesion.famille.condition && (
                <p class="formule__seance">{adhesion.famille.condition}</p>
              )}
            </div>
            <dl>
              <div><dt>Cotisation famille</dt><dd class="num">{euros(adhesion.famille.cotisation)}</dd></div>
              <div><dt>Licence adulte</dt><dd class="num">{euros(adhesion.famille.licence_adulte)}</dd></div>
              <div><dt>Licence jeune</dt><dd class="num">{euros(adhesion.famille.licence_jeune)}</dd></div>
              <div>
                <dt>
                  Forfait séances
                  {adhesion.famille.forfait_seances_precision && (
                    <>
                      <br />
                      <small>{adhesion.famille.forfait_seances_precision}</small>
                    </>
                  )}
                </dt>
                <dd class="num">{euros(adhesion.famille.forfait_seances_base)}</dd>
              </div>
              <div>
                <dt>Personne supplémentaire</dt>
                <dd class="num">{euros(adhesion.famille.forfait_seances_supplementaire)}</dd>
              </div>
            </dl>
          </div>
        )}
      </div>
      <div class="adhesion__action">
        <a class="bouton bouton--sombre" href="#infos">Nous contacter</a>
      </div>
    </div>
  </section>

  <section class="chapitre chapitre--vingt-quatre" id="les-24-heures-du-bassin-rond" data-section aria-labelledby="vq-titre">
    <div class="vq__tete">
      <h2 id="vq-titre">Les 24 heures du Bassin-Rond <span class="vq__sous">Chaque année, le premier week-end de septembre</span></h2>
      <p>Depuis le début des années 2000, l'évènement réunit plus de 5000 personnes sur un week-end. Reconnue d'intérêt communautaire, la manifestation est autant sportive que culturelle, et ouverte à tous, adhérent ou non.</p>
    </div>
    <div class="vq__mosaique">
      <figure class="vq__a">
        <img src={pVqA.src} srcset={pVqA.srcset} sizes={pVqA.sizes} width="1800" height="1146" loading="lazy" decoding="async" alt="Un paddeur déguisé en cowboy sur le bassin, entouré de radeaux et de bateaux, lors de la dernière édition sur le thème western.">
        <figcaption>Baptêmes nautiques : la dernière édition a pris des airs de western.</figcaption>
      </figure>
      <figure class="vq__b">
        <img src={pVqB.src} srcset={pVqB.srcset} sizes={pVqB.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="Le concert des 24 heures : un groupe joue sur scène devant le public, sous les arbres.">
        <figcaption>Le concert.</figcaption>
      </figure>
      <figure class="vq__c">
        <img src={pVqC.src} srcset={pVqC.srcset} sizes={pVqC.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="Une petite fille et une animatrice au chapeau de cow-boy font un atelier créatif sous la tente.">
        <figcaption>Ateliers créatifs.</figcaption>
      </figure>
      <figure class="vq__d">
        <img src={pVqD.src} srcset={pVqD.srcset} sizes={pVqD.sizes} width="1800" height="1350" loading="lazy" decoding="async" alt="Des enfants et leurs parents au jeu du lancer de balles, devant une structure gonflable jaune.">
        <figcaption>Jeux et animations sur la pelouse.</figcaption>
      </figure>
    </div>
    <ul class="vq__programme">
      <li>Baptêmes nautiques</li>
      <li>Concert</li>
      <li>Jeux</li>
      <li>Ateliers créatifs</li>
    </ul>
  </section>


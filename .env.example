# Serveur Node Astro SSR (derriere Apache sur VPS Contabo)
HOST=127.0.0.1
PORT=4323

# API centrale bassin-rond-api (PostgreSQL) — lecture /v1/public/vitrine, /summary, /stages
BASSIN_ROND_API_URL=http://127.0.0.1:8000

# Passer a true au moment de la mise en ligne definitive (robots.txt + meta robots)
INDEXABLE=false

# Duree (en secondes) du cache memoire + Cache-Control SSR
PUBLIC_CACHE_MAX_AGE=30
